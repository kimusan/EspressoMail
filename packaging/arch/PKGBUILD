# Maintainer: Kim Schulz <kim@schulz.dk>
pkgname=espressomail
pkgver=0.1.0
pkgrel=1
pkgdesc="A modern, multi-account terminal email client built on the Espresso TUI framework"
arch=('x86_64')
url="https://github.com/kimusan/EspressoMail"
license=('MIT')
depends=('glibc')
optdepends=(
    'chafa: high-resolution inline terminal image rendering'
    'gnupg: PGP/GPG email signing and encryption'
)
provides=('espressomail')
conflicts=('espressomail')
source=("espressomail"
        "espressomail.desktop"
        "espressomail.svg"
        "LICENSE"
        "README.md")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 "${srcdir}/espressomail" "${pkgdir}/usr/bin/espressomail"
    install -Dm644 "${srcdir}/espressomail.desktop" "${pkgdir}/usr/share/applications/espressomail.desktop"
    install -Dm644 "${srcdir}/espressomail.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/espressomail.svg"
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
